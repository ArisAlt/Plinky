<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "program": the first signing request of
     a Windows release (release.yml), Thyrion's own executable before the
     installers are built around it. Paste into SignPath under the project's
     artifact configurations with the slug "program". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="thyrion.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
